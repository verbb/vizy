{
    "name": "verbb/vizy",
    "description": "A flexible visual editor field for Craft.",
    "type": "craft-plugin",
    "version": "4.0.0-beta.1",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "tiptap",
        "prosemirror",
        "vizy"
    ],
    "support": {
        "email": "support@verbb.io",
        "issues": "https://github.com/verbb/vizy/issues?state=open",
        "source": "https://github.com/verbb/vizy",
        "docs": "https://github.com/verbb/vizy",
        "rss": "https://github.com/verbb/vizy/commits/v2.atom"
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "Verbb",
            "homepage": "https://verbb.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.9.0",
        "nystudio107/craft-plugin-vite": "^5.0.0",
        "ueberdosis/tiptap-php": "^1.0",
        "verbb/base": "^3.0.0",
        "yii2mod/yii2-array-query": "^1.4"
    },
    "require-dev": {
        "craftcms/generator": "^2.0.0",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin": "^3.0",
        "vlucas/phpdotenv": "^5.6",
        "yiisoft/yii2-shell": "^2.0.3"
    },
    "autoload": {
        "psr-4": {
            "verbb\\vizy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true,
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "test": "ddev test",
        "test:all": "ddev test --suite=all",
        "test:perf": "ddev test --suite=performance"
    },
    "extra": {
        "name": "Vizy",
        "handle": "vizy",
        "changelogUrl": "https://raw.githubusercontent.com/verbb/vizy/craft-5/CHANGELOG.md",
        "class": "verbb\\vizy\\Vizy"
    },
    "archive": {
        "exclude": [
            "/tests",
            "/storage",
            "/test-results",
            "/node_modules",
            "/vendor",
            "/.env*",
            "/.github",
            "/.idea",
            "/.vscode",
            "/package.json",
            "/package-lock.json",
            "/composer.lock",
            "/phpunit*.xml",
            "/tsconfig.json",
            "/vite.config.*",
            "/vitest.config.*",
            "/playwright.config.*",
            "/playwright.cp.config.*",
            "**/.DS_Store",
            "/.eslintrc.*",
            "/.pest.xml",
            "/config.codekit3",
            "/.gitattributes",
            "/.gitignore",
            "/.cache",
            "/.ddev"
        ]
    }
}
